# Copy this file to .env and fill in your real values.

# PostgreSQL connection (database must have the "vector" extension enabled)
DATABASE_URL=postgresql+psycopg://kb_user:kb_pass@localhost:5432/knowledgehub

# Google Gemini
GEMINI_API_KEY=AQ.Ab8RN6KI-P-tPM8-LVoQj-0E7drn0yYtSX5uNF5uHsI3vqVfLA
GEMINI_MODEL=gemini-3.6-flash

# JWT auth
JWT_SECRET=k3f9m2Lp8xQw1RtY6vBz4NcE7jHs0DgU
JWT_EXPIRE_MINUTES=480

# Embedding model (multilingual, supports Arabic + English)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Minimum similarity score (0-1) before the bot gives a fallback answer
RELEVANCE_THRESHOLD=0.35

# Speech-to-text
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Outgoing mail for temporary-password emails (leave blank to just print to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@knowledgehub.local
APP_BASE_URL=http://localhost:8000
